<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    # Legacy service URL redirects.
    RewriteRule ^services/(import-usa|prigon-usa)/?$ https://nikolacars.kiev.ua/services/prigon-tesla-usa/ [L,R=301]
    RewriteRule ^ru/services/(import-usa|prigon-usa)/?$ https://nikolacars.kiev.ua/ru/services/prigon-tesla-usa/ [L,R=301]
    RewriteRule ^services/restore-certificates/?$ https://nikolacars.kiev.ua/services/vidnovlennya-sertyfikativ-tesla/ [L,R=301]
    RewriteRule ^ru/services/restore-certificates/?$ https://nikolacars.kiev.ua/ru/services/vidnovlennya-sertyfikativ-tesla/ [L,R=301]

    # Canonical HTTPS host for production only.
    RewriteCond %{HTTP_HOST} ^(www\.)?nikolacars\.kiev\.ua$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.nikolacars\.kiev\.ua$ [NC]
    RewriteRule ^ https://nikolacars.kiev.ua%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
