APP_NAME=НиколаКарз
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# For local development, point public storage images at live when local media is absent.
# PUBLIC_STORAGE_FALLBACK_URL=https://sklad.nikolacars.kiev.ua/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sklad_zapchastey
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=sklad-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT=5

NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_PRINT_URL=https://my.novaposhta.ua/orders/printDocument
NOVA_POSHTA_TIMEOUT=15
NOVA_POSHTA_CONNECT_TIMEOUT=30
NOVA_POSHTA_SENDER_CITY_REF=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=
NOVA_POSHTA_SENDER_CONTACT_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_PAYER_TYPE=Recipient
NOVA_POSHTA_PAYMENT_METHOD=Cash
NOVA_POSHTA_DEFAULT_WEIGHT=1
NOVA_POSHTA_DEFAULT_SEATS_AMOUNT=1
NOVA_POSHTA_CARGO_DESCRIPTION="Auto parts"

PROM_FEED_TOKEN=
PROM_SHOP_NAME="${APP_NAME}"
PROM_COMPANY_NAME="${APP_NAME}"
