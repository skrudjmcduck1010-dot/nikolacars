APP_NAME=NikolaCars
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sklad.nikolacars.kiev.ua
ASSET_URL=https://sklad.nikolacars.kiev.ua

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sklad_zapchastey
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sklad.nikolacars.kiev.ua"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT=5

NOVA_POSHTA_API_KEY=
NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
NOVA_POSHTA_PRINT_URL=https://my.novaposhta.ua/orders/printDocument
NOVA_POSHTA_TIMEOUT=15
NOVA_POSHTA_CONNECT_TIMEOUT=30
NOVA_POSHTA_SENDER_CITY_REF=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=
NOVA_POSHTA_SENDER_CONTACT_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_PAYER_TYPE=Recipient
NOVA_POSHTA_PAYMENT_METHOD=Cash
NOVA_POSHTA_DEFAULT_WEIGHT=1
NOVA_POSHTA_DEFAULT_SEATS_AMOUNT=1
NOVA_POSHTA_CARGO_DESCRIPTION="автозапчастини"

PROM_FEED_TOKEN=
PROM_SHOP_NAME="${APP_NAME}"
PROM_COMPANY_NAME="${APP_NAME}"

# Set to "*" when the app is behind a trusted reverse proxy/load balancer
# that sends X-Forwarded-* headers, for example Nginx proxy or Cloudflare.
TRUSTED_PROXIES=*
